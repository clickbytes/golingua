{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/lexical-binding.schema.json",
  "title": "Strict lexical semantic binding record",
  "description": "One version-1 lexical binding. Legacy CORE bindings retain their original fields; explicit semantic targets are a separate tagged branch.",
  "$comment": "Runtime bounds the complete lexical document to 4 MiB and each target payload to 1 MiB with bounded JSON nesting. Structural goal validation does not authenticate selected metadata. Exact execution additionally requires an approved equivalent mapping, valid provenance, an explicitly selected registry/context, and runtime validation of symbol signature or goal template against that registry. No callback or label interpretation is supported.",
  "oneOf": [
    { "$ref": "#/$defs/core_binding" },
    { "$ref": "#/$defs/target_binding" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\s]+$",
      "$comment": "Runtime enforces UTF-8 byte bounds and identifier syntax."
    },
    "mapping_kind": { "enum": ["equivalent", "broad", "narrow", "related", "candidate"] },
    "binding_status": { "enum": ["pending", "approved"] },
    "provenance": { "$ref": "goals.schema.json#/$defs/source_ref" },
    "common": {
      "type": "object",
      "required": ["sense_id", "mapping_kind", "status", "provenance"],
      "properties": {
        "sense_id": { "$ref": "#/$defs/id" },
        "mapping_kind": { "$ref": "#/$defs/mapping_kind" },
        "status": { "$ref": "#/$defs/binding_status" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "core_binding": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sense_id", "core_ref", "mapping_kind", "status", "provenance"],
          "properties": {
            "sense_id": { "$ref": "#/$defs/id" },
            "core_ref": { "$ref": "#/$defs/id" },
            "mapping_kind": { "$ref": "#/$defs/mapping_kind" },
            "status": { "$ref": "#/$defs/binding_status" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "target_binding": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["sense_id", "target", "mapping_kind", "status", "provenance"],
          "properties": {
            "sense_id": { "$ref": "#/$defs/id" },
            "target": { "$ref": "#/$defs/target" },
            "mapping_kind": { "$ref": "#/$defs/mapping_kind" },
            "status": { "$ref": "#/$defs/binding_status" },
            "provenance": { "$ref": "#/$defs/provenance" }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "kind", "profile", "symbol_ref", "role_ports"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "symbol" },
            "profile": { "const": "positive-facts-v1" },
            "symbol_ref": { "$ref": "#/$defs/id" },
            "role_ports": { "$ref": "#/$defs/role_ports" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "kind", "profile", "goal_spec", "role_ports"],
          "properties": {
            "schema_version": { "const": 1 },
            "kind": { "const": "goal" },
            "profile": { "const": "positive-facts-v1" },
            "goal_spec": { "$ref": "goals.schema.json" },
            "role_ports": { "$ref": "#/$defs/role_ports" }
          }
        }
      ]
    },
    "role_ports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/role_port" },
      "$comment": "Runtime requires unique frame+role and frame+port pairs, a sense-declared frame ID, exact GoalSpec port types when a goal target is used, and later checks symbol ports against the selected registry."
    },
    "role_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame_id", "role", "port_id", "type"],
      "properties": {
        "frame_id": { "$ref": "#/$defs/id" },
        "role": { "$ref": "#/$defs/id" },
        "port_id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "expression.schema.json#/$defs/type" }
      }
    },
    "semantic_language_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "version", "language", "provenance", "lexicon", "frames"],
      "properties": {
        "schema_version": { "const": 1 },
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "language": { "type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[a-z]{2,8}(-[a-z0-9]{1,8})*$" },
        "provenance": { "$ref": "goals.schema.json#/$defs/source_ref" },
        "lexicon": { "$ref": "#/$defs/lexical_document" },
        "frames": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/valency_frame" } }
      },
      "$comment": "The complete package is bounded to 8 MiB; nested lexical document to 4 MiB. Loading resolves typed IDs, sense/frame links, and target mappings, then builds immutable lexicon and valency indexes. Frame data grants no parser or realizer permission by itself."
    },
    "lexical_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "lexemes", "senses", "bindings"],
      "properties": {
        "schema_version": { "const": 1 },
        "lexemes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lexeme" } },
        "senses": { "type": "array", "items": { "$ref": "#/$defs/lexical_sense" } },
        "bindings": { "type": "array", "items": { "$ref": "lexical-binding.schema.json" } }
      }
    },
    "lexeme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "language", "lemma", "pos"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "lemma": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "pos": { "type": "string", "minLength": 1, "maxLength": 64 },
        "properties": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/lexical_property" } },
        "paradigm_id": { "type": "string", "maxLength": 128 }
      }
    },
    "lexical_property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value"],
      "properties": { "key": { "type": "string", "minLength": 1, "maxLength": 128 }, "value": { "type": "string", "minLength": 1, "maxLength": 1024 } }
    },
    "lexical_sense": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "lexeme_id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "lexeme_id": { "$ref": "#/$defs/id" },
        "register": { "type": "string", "maxLength": 64 },
        "usage": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
        "valency_ids": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "valency_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sense_id", "semantic_roles", "arguments", "allowed_family_ids", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "sense_id": { "$ref": "#/$defs/id" },
        "semantic_roles": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
        "arguments": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/valency_argument" } },
        "selectional_constraints": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/valency_constraint" } },
        "allowed_family_ids": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/id" } },
        "provenance": { "$ref": "goals.schema.json#/$defs/source_ref" }
      }
    },
    "valency_argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "required": { "type": "boolean" },
        "grammatical_function": { "type": "string", "maxLength": 128 },
        "case": { "type": "string", "maxLength": 128 },
        "adposition": { "type": "string", "maxLength": 128 }
      }
    },
    "valency_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "strength"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "role": { "type": "string", "minLength": 1, "maxLength": 128 },
        "strength": { "enum": ["hard", "soft"] },
        "allowed_concept_ids": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/id" } },
        "allowed_kinds": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
      },
      "$comment": "At least one of allowed_concept_ids or allowed_kinds is required by ValencyFrame validation."
    },
    "semantic_binding_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sense_id", "frame_id", "context_id", "references", "role_references", "port_references"],
      "properties": {
        "sense_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "frame_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "binding_index": { "type": "integer", "minimum": 0 },
        "context_id": { "$ref": "#/$defs/id" },
        "references": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/request_reference" } },
        "request_context": { "$ref": "context.schema.json" },
        "role_references": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/role_reference" } },
        "port_references": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/port_reference" } },
        "verification_limits": { "$ref": "#/$defs/verification_limits" }
      },
      "$comment": "The runtime parses sense_id from an explicit string into the typed ID. Every reference is caller-declared; no free variable, callback, or label is accepted."
    },
    "request_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "$ref": "expression.schema.json#/$defs/type" },
        "temporal_frame": { "type": "string", "maxLength": 256 },
        "reference_time_id": { "type": "string", "maxLength": 256 },
        "multiplicity": { "type": "string", "maxLength": 256 }
      }
    },
    "role_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "reference_id"],
      "properties": { "role": { "$ref": "#/$defs/id" }, "reference_id": { "$ref": "#/$defs/id" } }
    },
    "port_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["port_id", "reference_id"],
      "properties": { "port_id": { "$ref": "#/$defs/id" }, "reference_id": { "$ref": "#/$defs/id" } }
    },
    "verification_limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_certificate_bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "max_replay_steps": { "type": "integer", "minimum": 0, "maximum": 64 },
        "max_work_nodes": { "type": "integer", "minimum": 0, "maximum": 262144 },
        "term_limits": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "max_nodes": { "type": "integer", "minimum": 0, "maximum": 4096 },
            "max_depth": { "type": "integer", "minimum": 0, "maximum": 64 },
            "max_type_depth": { "type": "integer", "minimum": 0, "maximum": 32 },
            "max_symbols": { "type": "integer", "minimum": 0, "maximum": 512 },
            "max_ports": { "type": "integer", "minimum": 0, "maximum": 16 }
          }
        }
      }
    }
  }
}
