{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/goals.schema.json",
  "title": "GoLingua bounded positive-facts construction goal",
  "description": "Strict wire shape for a finite goal request. It is not a final expression, construction recipe, proof, or world fact.",
  "$comment": "Runtime hard limit is 1048576 encoded UTF-8 bytes with JSON nesting at most 256. Runtime also validates nominal sorts, declaration types, source references, symbol signatures, role mappings, unique IDs, underdetermination, operator permissions, and aggregate budgets against explicitly selected metadata. Empty or multiple permitted choices remain unresolved; the schema does not choose a candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "context_id", "expected_type", "ports", "references", "allowed_operators", "constraints", "provenance", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "positive-facts-v1"},
    "context_id": {"$ref": "#/$defs/id"},
    "expected_type": {"$ref": "expression.schema.json#/$defs/type"},
    "ports": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/goal_port"}},
    "references": {"type": "array", "maxItems": 512, "items": {"$ref": "expression.schema.json#/$defs/declaration"}},
    "allowed_operators": {"type": "array", "maxItems": 5, "uniqueItems": true, "items": {"enum": ["relation", "join", "restrict", "bind", "permute"]}},
    "constraints": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/constraint"}},
    "provenance": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/source_ref"}},
    "limits": {"$ref": "#/$defs/goal_limits"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\s]+$",
      "$comment": "Runtime bound is 256 UTF-8 bytes and ValidateGoal is authoritative for identifier validity. This schema regex may be stricter for interior Unicode whitespace."
    },
    "goal_port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"$ref": "expression.schema.json#/$defs/type"},
        "binding": {"$ref": "#/$defs/goal_binding"}
      }
    },
    "goal_binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "type"],
          "properties": {"kind": {"const": "Ref"}, "id": {"$ref": "#/$defs/id"}, "type": {"$ref": "expression.schema.json#/$defs/type"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "type"],
          "properties": {"kind": {"const": "Hole"}, "id": {"$ref": "#/$defs/id"}, "type": {"$ref": "expression.schema.json#/$defs/type"}}
        }
      ],
      "$comment": "A Ref must match an explicit request reference. A typed Hole remains unresolved and is never a witness or operator input."
    },
    "constraint": {
      "oneOf": [
        {"$ref": "#/$defs/path_constraint"},
        {"$ref": "#/$defs/unary_constraint"}
      ]
    },
    "path_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from_port", "to_port"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "path"},
        "symbol": {"type": "string", "maxLength": 256},
        "from_port": {"$ref": "#/$defs/id"},
        "to_port": {"$ref": "#/$defs/id"},
        "from_role": {"type": "string", "maxLength": 256},
        "to_role": {"type": "string", "maxLength": 256},
        "allowed_atom_counts": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1, "maximum": 16}
        }
      },
      "$comment": "An omitted or empty symbol/role/count choice is decoded as underdetermined. Multiple permitted counts are unresolved, not an instruction to choose one. The initial construction profile supports one binary path; aggregate atom limits also include unary constraints."
    },
    "unary_constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"const": "unary"},
        "symbol": {"type": "string", "maxLength": 256},
        "port": {"type": "string", "maxLength": 256}
      },
      "$comment": "A missing symbol or port remains unresolved. Path-only fields are forbidden."
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
        "path": {"type": "string", "maxLength": 2048},
        "uri": {"type": "string", "maxLength": 2048},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "author": {"type": "string", "maxLength": 256},
        "checksum_sha256": {"type": "string", "maxLength": 64, "pattern": "^([0-9a-f]{64})?$"}
      },
      "anyOf": [
        {"required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}, "not": {"required": ["uri"], "properties": {"uri": {"type": "string", "minLength": 1}}}},
        {"required": ["uri"], "properties": {"uri": {"type": "string", "minLength": 1}}, "not": {"required": ["path"], "properties": {"path": {"type": "string", "minLength": 1}}}}
      ],
      "$comment": "Runtime applies SourceRef.Validate: exactly one location must be nonempty; an explicitly empty optional counterpart is allowed. Attribution is not approval and no path/URI is loaded. All limits are UTF-8 byte limits at runtime."
    },
    "term_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_type_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_symbols": {"type": "integer", "minimum": 0, "maximum": 512},
        "max_ports": {"type": "integer", "minimum": 0, "maximum": 16}
      },
      "$comment": "Zero or omitted values select the common algebra defaults. Runtime rejects null values."
    },
    "goal_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_atoms": {"type": "integer", "minimum": 0, "maximum": 16},
        "max_steps": {"type": "integer", "minimum": 0, "maximum": 64},
        "term_limits": {"$ref": "#/$defs/term_limits"}
      },
      "$comment": "The root limits object is required. Zero and omitted per-field values select bounded defaults. Goal atom count includes path occurrences plus unary constraints; runtime validates aggregate counts and minimum operator steps."
    }
  }
}
