{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/proof.schema.json",
  "title": "GoLingua bounded algebra rewrite request and certificate",
  "description": "Strict wire shapes for finite normalization requests and independently checked rewrite certificates. Shape validity does not establish proof validity.",
  "$comment": "Runtime byte ceilings: normalization request 1 MiB, each term 1 MiB, certificate 8 MiB, verification envelope 16 MiB; all use the shared duplicate-key, UTF-8, surrogate and nesting guards. These byte and aggregate limits are not fully expressible in JSON Schema. Metadata is supplied separately by explicit CLI --metadata paths; no environment or alias definitions are accepted on this wire.",
  "oneOf": [
    {"$ref": "#/$defs/normalization_request"},
    {"$ref": "#/$defs/rewrite_certificate"},
    {"$ref": "#/$defs/verification_request"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "$comment": "Runtime maximum is 256 UTF-8 bytes."},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rules"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rules": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["alpha_v1", "beta_v1", "alias_v1", "and_flatten_v1", "and_order_v1", "and_deduplicate_v1"]}}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 0, "maximum": 128},
        "max_expansions": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_trace_nodes": {"type": "integer", "minimum": 0, "maximum": 32768},
        "max_work_nodes": {"type": "integer", "minimum": 0, "maximum": 262144}
      },
      "$comment": "Zero and omitted values select the respective runtime defaults."
    },
    "normalization_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document", "profile"],
      "properties": {
        "schema_version": {"const": 1},
        "document": {"$ref": "expression.schema.json"},
        "profile": {"$ref": "#/$defs/profile"},
        "budget": {"$ref": "#/$defs/budget"}
      }
    },
    "binder_change": {
      "type": "object", "additionalProperties": false,
      "required": ["before", "after", "kind"],
      "properties": {
        "before": {"type": "string", "maxLength": 256},
        "after": {"type": "string", "maxLength": 256},
        "kind": {"enum": ["retained", "renamed", "removed", "introduced"]}
      },
      "$comment": "Empty before/after spellings are permitted for introduced/removed identities; replay validates their use."
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "path", "before", "after", "snapshot_id", "profile_id", "before_nodes", "after_nodes"],
      "properties": {
        "rule_id": {"enum": ["alpha_v1", "beta_v1", "alias_v1", "and_flatten_v1", "and_order_v1", "and_deduplicate_v1"]},
        "path": {"type": "array", "maxItems": 64, "items": {"type": "integer", "minimum": 0, "maximum": 4095}, "$comment": "The empty array identifies the root term."},
        "before": {"$ref": "expression.schema.json#/$defs/term"},
        "after": {"$ref": "expression.schema.json#/$defs/term"},
        "binder_mapping": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/binder_change"}},
        "parameter_mapping": {"type": "object", "maxProperties": 0, "additionalProperties": false, "$comment": "These rewrite rules do not rewrite free parameters; only an absent or empty mapping is valid."},
        "side_conditions": {"type": "array", "maxItems": 8192, "items": {"type": "string", "maxLength": 2048}},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "profile_id": {"$ref": "#/$defs/id"},
        "before_nodes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "after_nodes": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "rewrite_certificate": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "snapshot_id", "profile", "input", "output", "steps", "normalized"],
      "properties": {
        "schema_version": {"const": 1},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "profile": {"$ref": "#/$defs/profile"},
        "input": {"$ref": "expression.schema.json#/$defs/term"},
        "output": {"$ref": "expression.schema.json#/$defs/term"},
        "steps": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/step"}},
        "normalized": {"type": "boolean"}
      },
      "$comment": "An empty steps array is valid for a no-op prefix; the independent verifier checks every claimed transition and completion."
    },
    "verification_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request", "certificate"],
      "properties": {
        "schema_version": {"const": 1},
        "request": {"$ref": "#/$defs/normalization_request"},
        "certificate": {"$ref": "#/$defs/rewrite_certificate"}
      }
    }
  }
}
