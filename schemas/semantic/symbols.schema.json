{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/symbols.schema.json",
  "title": "GoLingua metadata symbol records",
  "description": "Strict tagged symbol forms. Labels, descriptions, provenance, and review status do not execute.",
  "oneOf": [
    {"$ref": "#/$defs/primitive"},
    {"$ref": "#/$defs/alias"},
    {"$ref": "#/$defs/opaque"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "$comment": "Runtime bound is 256 UTF-8 bytes."},
    "common": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["primitive", "alias", "opaque_unformalized"]},
        "label": {"type": "string", "maxLength": 1024, "$comment": "Runtime bound is 1024 UTF-8 bytes."},
        "description": {"type": "string", "maxLength": 2048, "$comment": "Runtime bound is 2048 UTF-8 bytes."},
        "review_status": {"enum": ["pending", "approved"]},
        "provenance": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "package.schema.json#/$defs/source_ref"}}
      },
      "required": ["id", "kind", "review_status", "provenance"]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "type"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "type": {"$ref": "expression.schema.json#/$defs/sort_type"}
      }
    },
    "ports": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/port"}},
    "constraint": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {"kind": {"const": "arity"}, "count": {"type": "integer", "minimum": 0, "maximum": 16}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "role", "type"], "properties": {"kind": {"const": "port_type"}, "role": {"$ref": "#/$defs/id"}, "type": {"$ref": "expression.schema.json#/$defs/sort_type"}}}
      ],
      "$comment": "Structural only; no inequality or world-rule semantics."
    },
    "constraints": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/constraint"}},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "binder"],
      "properties": {"port": {"$ref": "#/$defs/id"}, "binder": {"$ref": "#/$defs/id"}}
    },
    "alias_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "interface"],
      "properties": {
        "expression": {"$ref": "expression.schema.json#/$defs/term"},
        "interface": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/binding"}}
      },
      "$comment": "The interface maps ports to distinct leading lambda binders; closure and binder validation occur later."
    },
    "primitive": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "unevaluatedProperties": false, "required": ["ports"], "properties": {"id": {}, "kind": {"const": "primitive"}, "label": {}, "description": {}, "review_status": {}, "provenance": {}, "ports": {"$ref": "#/$defs/ports"}, "constraints": {"$ref": "#/$defs/constraints"}}}
      ]
    },
    "alias": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "unevaluatedProperties": false, "required": ["ports", "alias"], "properties": {"id": {}, "kind": {"const": "alias"}, "label": {}, "description": {}, "review_status": {}, "provenance": {}, "ports": {"$ref": "#/$defs/ports"}, "constraints": {"$ref": "#/$defs/constraints"}, "alias": {"$ref": "#/$defs/alias_value"}}}
      ]
    },
    "opaque": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "unevaluatedProperties": false, "properties": {"id": {}, "kind": {"const": "opaque_unformalized"}, "label": {}, "description": {}, "review_status": {}, "provenance": {}}}
      ]
    },
    "symbol": {"oneOf": [{"$ref": "#/$defs/primitive"}, {"$ref": "#/$defs/alias"}, {"$ref": "#/$defs/opaque"}]}
  }
}
