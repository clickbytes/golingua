{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/expression.schema.json",
  "title": "GoLingua typed semantic expression document",
  "description": "Strict version 1 in-memory expression and declarations. Runtime additionally enforces UTF-8 byte limits, duplicate-key rejection, and bounded JSON nesting before decoding.",
  "$comment": "Maximum encoded document size is 1048576 bytes. Runtime limits: 4096 expression nodes, depth 64, type depth 32, 512 aggregate declarations, and 16 ports. Zero requested limits select defaults. Labels are presentation only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expression"],
  "properties": {
    "schema_version": {"const": 1},
    "sorts": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/sort"}
    },
    "signatures": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/signature"}
    },
    "parameters": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/declaration"}
    },
    "references": {
      "type": "array",
      "maxItems": 512,
      "items": {"$ref": "#/$defs/reference_declaration"}
    },
    "closed": {"type": "boolean"},
    "expression": {"$ref": "#/$defs/term"},
    "limits": {"$ref": "#/$defs/limits"},
    "request_context": {"$ref": "context.schema.json"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "$comment": "Runtime additionally enforces a maximum of 256 UTF-8 bytes."},
    "label": {"type": "string", "maxLength": 1024, "$comment": "Optional presentation text only; runtime maximum: 1024 UTF-8 bytes."},
    "sort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}}
    },
    "type": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Entity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Event"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Interval"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Prop"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Question"}}, "$comment": "A typed question act, distinct from a proposition; this type does not assert an answer."},
        {"type": "object", "additionalProperties": false, "required": ["kind", "sort_id"], "properties": {"kind": {"const": "Nominal"}, "sort_id": {"$ref": "#/$defs/id"}}, "$comment": "sort_id must also appear in the document's sorts list."},
        {"type": "object", "additionalProperties": false, "required": ["kind", "from", "to"], "properties": {"kind": {"const": "Arrow"}, "from": {"$ref": "#/$defs/type"}, "to": {"$ref": "#/$defs/type"}}}
      ]
    },
    "sort_type": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Entity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Event"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Interval"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Prop"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Question"}}, "$comment": "Question is an atomic act type, not a proposition."},
        {"type": "object", "additionalProperties": false, "required": ["kind", "sort_id"], "properties": {"kind": {"const": "Nominal"}, "sort_id": {"$ref": "#/$defs/id"}}, "$comment": "sort_id must also appear in the document's sorts list."}
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "type"],
      "properties": {"role": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/sort_type"}}
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ports"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"$ref": "#/$defs/label"},
        "ports": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/port"}}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/type"}}
    },
    "reference_declaration": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/type"}, "temporal_frame": {"enum": ["past", "present"]}, "reference_time_id": {"$ref": "#/$defs/id"}, "multiplicity": {"enum": ["one", "many"]}},
      "$comment": "Runtime permits temporal_frame/reference_time_id only for Event and multiplicity only for Entity or Nominal; reference_time_id must name an Interval in the same available reference context."
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "value"],
      "properties": {"role": {"$ref": "#/$defs/id"}, "value": {"$ref": "#/$defs/term"}}
    },
    "term": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": {"kind": {"const": "Var"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type"], "properties": {"kind": {"const": "Param"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type"], "properties": {"kind": {"const": "Ref"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type"], "properties": {"kind": {"const": "Hole"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "symbol", "args"], "properties": {"kind": {"const": "Atom"}, "label": {"$ref": "#/$defs/label"}, "symbol": {"$ref": "#/$defs/id"}, "args": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/argument"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "operands"], "properties": {"kind": {"const": "And"}, "label": {"$ref": "#/$defs/label"}, "operands": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/term"}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type", "body"], "properties": {"kind": {"const": "Exists"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type", "body"], "properties": {"kind": {"const": "Lambda"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "body"], "properties": {"kind": {"const": "Not"}, "label": {"$ref": "#/$defs/label"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "modality", "body"], "properties": {"kind": {"const": "Modal"}, "label": {"$ref": "#/$defs/label"}, "modality": {"enum": ["possible", "necessary", "likely"]}, "modal_profile": {"$ref": "#/$defs/id"}, "body": {"$ref": "#/$defs/term"}}, "$comment": "Modal body must type-check as Prop. The tree is represented without modal laws or truth evaluation."},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type", "quantifier", "body"], "properties": {"kind": {"const": "Quantifier"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/data_type"}, "quantifier": {"enum": ["some", "all"]}, "restrictor": {"$ref": "#/$defs/optional_prop_term"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "id", "type", "quantifier", "count", "body"], "properties": {"kind": {"const": "Quantifier"}, "id": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/data_type"}, "quantifier": {"enum": ["exactly", "at_least", "at_most"]}, "count": {"type": "integer", "minimum": 0}, "restrictor": {"$ref": "#/$defs/optional_prop_term"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "body"], "properties": {"kind": {"const": "Ask"}, "label": {"$ref": "#/$defs/label"}, "answers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/data_declaration"}}, "restrictor": {"$ref": "#/$defs/optional_prop_term"}, "body": {"$ref": "#/$defs/term"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "function", "argument"], "properties": {"kind": {"const": "Apply"}, "label": {"$ref": "#/$defs/label"}, "function": {"$ref": "#/$defs/term"}, "argument": {"$ref": "#/$defs/term"}}}
      ]
    },
    "data_type": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Entity"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Event"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "Interval"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "sort_id"], "properties": {"kind": {"const": "Nominal"}, "sort_id": {"$ref": "#/$defs/id"}}, "$comment": "The nominal sort ID must be declared in the containing document."}
      ]
    },
    "data_declaration": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"$ref": "#/$defs/data_type"}}
    },
    "optional_prop_term": {
      "anyOf": [{"$ref": "#/$defs/term"}, {"type": "null"}],
      "$comment": "Omitted or null means no additional restriction; runtime requires a present restriction expression to have type Prop. An empty object is malformed."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_type_depth": {"type": "integer", "minimum": 0, "maximum": 32},
        "max_symbols": {"type": "integer", "minimum": 0, "maximum": 512},
        "max_ports": {"type": "integer", "minimum": 0, "maximum": 16}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "expression"],
      "properties": {
        "schema_version": {"const": 1},
        "sorts": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/sort"}},
        "signatures": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/signature"}},
        "parameters": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/declaration"}},
        "references": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/reference_declaration"}},
        "closed": {"type": "boolean"},
        "expression": {"$ref": "#/$defs/term"},
        "limits": {"$ref": "#/$defs/limits"},
        "request_context": {"$ref": "context.schema.json"}
      },
      "$comment": "The existing root schema remains the ordinary expression document. This definition permits the same document shape when nested in an artifact export request."
    },
    "rewrite_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rules"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rules": {
          "type": "array", "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["alpha_v1", "beta_v1", "alias_v1", "and_flatten_v1", "and_order_v1", "and_deduplicate_v1"]}
        }
      }
    },
    "registry_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "resource_fingerprint", "formal_denotation_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/id"},
        "resource_fingerprint": {"$ref": "#/$defs/id"}, "formal_denotation_id": {"$ref": "#/$defs/id"}
      }
    },
    "context_dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "fingerprint"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "fingerprint": {"$ref": "#/$defs/id"}}
    },
    "source_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "path": {"type": "string", "minLength": 1, "maxLength": 2048},
        "uri": {"type": "string", "minLength": 1, "maxLength": 2048},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "author": {"type": "string", "maxLength": 256},
        "checksum_sha256": {"type": "string", "pattern": "^([0-9a-f]{64})?$"}
      },
      "oneOf": [
        {"required": ["path"], "not": {"required": ["uri"]}},
        {"required": ["uri"], "not": {"required": ["path"]}}
      ],
      "$comment": "Runtime validates normalized relative paths or absolute URIs and exact source metadata bounds; no resource is fetched."
    },
    "artifact_node_argument": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "value"],
      "properties": {
        "role": {"$ref": "#/$defs/id"},
        "value": {"type": "integer", "minimum": 1, "maximum": 4096}
      }
    },
    "artifact_node": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Var"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Param"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Ref"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Hole"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "symbol", "args"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Atom"}, "label": {"$ref": "#/$defs/label"}, "symbol": {"$ref": "#/$defs/id"}, "args": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/artifact_node_argument"}}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "operands"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "And"}, "label": {"$ref": "#/$defs/label"}, "operands": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"type": "integer", "minimum": 1, "maximum": 4096}}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Exists"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Lambda"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/type"}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Not"}, "label": {"$ref": "#/$defs/label"}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "modality", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Modal"}, "label": {"$ref": "#/$defs/label"}, "modality": {"enum": ["possible", "necessary", "likely"]}, "modal_profile": {"$ref": "#/$defs/id"}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type", "quantifier", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Quantifier"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/data_type"}, "quantifier": {"enum": ["some", "all"]}, "restrictor": {"type": "integer", "minimum": 1, "maximum": 4096}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "identity", "type", "quantifier", "count", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Quantifier"}, "identity": {"$ref": "#/$defs/id"}, "label": {"$ref": "#/$defs/label"}, "type": {"$ref": "#/$defs/data_type"}, "quantifier": {"enum": ["exactly", "at_least", "at_most"]}, "count": {"type": "integer", "minimum": 0}, "restrictor": {"type": "integer", "minimum": 1, "maximum": 4096}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "answers", "body"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Ask"}, "label": {"$ref": "#/$defs/label"}, "answers": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/data_declaration"}}, "restrictor": {"type": "integer", "minimum": 1, "maximum": 4096}, "body": {"type": "integer", "minimum": 1, "maximum": 4096}}},
        {"type": "object", "additionalProperties": false, "required": ["node_id", "kind", "function", "argument"], "properties": {"node_id": {"type": "integer", "minimum": 1, "maximum": 4096}, "kind": {"const": "Apply"}, "label": {"$ref": "#/$defs/label"}, "function": {"type": "integer", "minimum": 1, "maximum": 4096}, "argument": {"type": "integer", "minimum": 1, "maximum": 4096}}}
      ],
      "$comment": "DAG edge reachability, dense NodeIDs, cycles, scope, and typing are checked at runtime; JSON Schema validates only the bounded node record shapes."
    },
    "artifact_envelope": {
      "type": "object", "additionalProperties": false,
      "dependentRequired": {"request_context": ["request_context_fingerprint"], "request_context_fingerprint": ["request_context"]},
      "required": ["kind", "schema_version", "normalizer_version", "registry_snapshot_id", "registries", "profile", "context_id", "context_dependencies", "sorts", "signatures", "parameters", "references", "closed", "limits", "root", "nodes", "provenance", "resource_fingerprint", "meaning_fingerprint", "cache_key"],
      "properties": {
        "kind": {"const": "typed_expression_dag"}, "schema_version": {"const": 1},
        "normalizer_version": {"const": "dse-normalizer-v1"}, "registry_snapshot_id": {"$ref": "#/$defs/id"},
        "registries": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/registry_pin"}},
        "profile": {"$ref": "#/$defs/rewrite_profile"}, "context_id": {"$ref": "#/$defs/id"},
        "request_context": {"$ref": "context.schema.json"},
        "request_context_fingerprint": {"type": "string", "pattern": "^algebra-request-context-v1:sha256:[0-9a-f]{64}$", "$comment": "Runtime recomputes this pin from the canonical bounded request_context payload."},
        "context_dependencies": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/context_dependency"}},
        "sorts": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/sort"}},
        "signatures": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/signature"}},
        "parameters": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/declaration"}},
        "references": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/reference_declaration"}},
        "closed": {"type": "boolean"}, "limits": {"$ref": "#/$defs/limits"},
        "root": {"type": "integer", "minimum": 1, "maximum": 4096},
        "nodes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/artifact_node"}},
        "provenance": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/source_ref"}},
        "resource_fingerprint": {"$ref": "#/$defs/id"}, "meaning_fingerprint": {"$ref": "#/$defs/id"}, "cache_key": {"$ref": "#/$defs/id"}
      },
      "$comment": "Runtime enforces the 8 MiB artifact cap and receipt consistency. When present, request_context_fingerprint is recomputed from the bounded context payload and checked against an independently selected context during replay. A receipt is not proof or metadata authentication."
    },
    "artifact_export_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document", "profile", "context_id", "context_dependencies", "provenance"],
      "properties": {
        "schema_version": {"const": 1}, "document": {"$ref": "#/$defs/document"},
        "profile": {"$ref": "#/$defs/rewrite_profile"}, "context_id": {"$ref": "#/$defs/id"},
        "context_dependencies": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/context_dependency"}},
        "provenance": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/source_ref"}}
      },
      "$comment": "Runtime enforces a 1 MiB request cap and checks inline source declarations against actual selected metadata."
    },
    "artifact_replay_request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "profile", "context_id", "context_dependencies", "provenance", "artifact"],
      "properties": {
        "schema_version": {"const": 1}, "profile": {"$ref": "#/$defs/rewrite_profile"},
        "context_id": {"$ref": "#/$defs/id"},
        "request_context": {"$ref": "context.schema.json"},
        "context_dependencies": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/context_dependency"}},
        "provenance": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/source_ref"}},
        "limits": {"$ref": "#/$defs/limits"}, "artifact": {"$ref": "#/$defs/artifact_envelope"}
      },
      "$comment": "Profile/context/provenance are independent expected inputs. Runtime enforces a 16 MiB envelope cap; actual selected metadata must be supplied separately."
    }
  }
}
