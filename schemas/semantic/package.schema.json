{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/clickbytes/golingua/schemas/semantic/package.schema.json",
  "title": "GoLingua semantic metadata package",
  "description": "Strict wire shape for the positive-facts-v1 metadata manifest. Decoding does not resolve references or activate a registry.",
  "$comment": "Runtime hard limit: 1048576 encoded UTF-8 bytes and JSON nesting 256. IDs and labels are bounded in UTF-8 bytes by runtime. Nonempty provenance is structurally decoded; SourceRef.Validate is a later validation step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "profile", "provenance", "sorts", "symbols", "dependencies", "typical_edges", "axioms"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "minLength": 1, "maxLength": 256},
    "profile": {"const": "positive-facts-v1"},
    "provenance": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/source_ref"}},
    "sorts": {"type": "array", "maxItems": 512, "items": {"$ref": "expression.schema.json#/$defs/sort"}},
    "symbols": {"type": "array", "maxItems": 512, "items": {"$ref": "symbols.schema.json#/$defs/symbol"}},
    "dependencies": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/dependency"}},
    "typical_edges": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/typical_edge"}},
    "axioms": {"type": "array", "maxItems": 0, "items": false, "$comment": "Nonempty axiom lists are unsupported by positive-facts-v1."}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "$comment": "Runtime bound is 256 UTF-8 bytes."},
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "path": {"type": "string", "maxLength": 2048},
        "uri": {"type": "string", "maxLength": 2048},
        "version": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 256},
        "author": {"type": "string", "maxLength": 256},
        "checksum_sha256": {"type": "string", "maxLength": 64}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "fingerprint"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1, "maxLength": 256}, "fingerprint": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "typical_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {"from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1, "maxLength": 64}},
      "$comment": "Descriptive only; this edge is not a fact or axiom."
    }
  }
}
