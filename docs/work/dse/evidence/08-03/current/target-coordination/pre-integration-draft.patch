diff --git a/internal/engine/algebra_coordination.go b/internal/engine/algebra_coordination.go
new file mode 100644
index 0000000..5ab8ed5
--- /dev/null
+++ b/internal/engine/algebra_coordination.go
@@ -0,0 +1,348 @@
+package engine
+
+import (
+	"context"
+	"fmt"
+	"sort"
+
+	"github.com/clickbytes/golingua/internal/algebra"
+	"github.com/clickbytes/golingua/internal/features"
+	"github.com/clickbytes/golingua/internal/ids"
+	"github.com/clickbytes/golingua/internal/language"
+	"github.com/clickbytes/golingua/internal/lexicon"
+	"github.com/clickbytes/golingua/internal/meaning"
+	"github.com/clickbytes/golingua/internal/semantic"
+	"github.com/clickbytes/golingua/internal/status"
+)
+
+// realizeTwoAtomAnd builds one statement graph for exactly two directly
+// supported positive atoms. A non-nil result means the bounded route matched.
+func (engine *Engine) realizeTwoAtomAnd(ctx context.Context, input algebra.Document, languageID features.LanguageID, pkg *language.SemanticLanguagePackage, matches []algebraAtomMatch, residuals []AlgebraRealizationResidual, refuseContextResiduals bool) (*AlgebraRealizationResult, error) {
+	if input.Expression == nil || input.Expression.Kind != algebra.TermAnd || len(input.Expression.Operands) != 2 {
+		return nil, nil
+	}
+	result := AlgebraRealizationResult{Status: status.OutcomeInvalid, Language: string(languageID), LanguagePackage: pkg.ID(), PackageVersion: pkg.Version(), Coverage: []AlgebraRealizationCoverage{}, Residuals: append([]AlgebraRealizationResidual{}, residuals...), Alternatives: []SurfaceAlternative{}, Diagnostics: []status.Diagnostic{}, Scope: "exact two ordered positive direct Atoms under And; each clause must have a verified target realization, then the language-local coordination plan joins the clauses; residuals and target assumptions remain explicit"}
+	if len(residuals) != 0 {
+		result.Status = status.OutcomeUnsupported
+		return &result, nil
+	}
+	if len(matches) != 2 {
+		result.Status = status.OutcomeUnsupported
+		result.Residuals = append(result.Residuals, AlgebraRealizationResidual{Path: "input.expression", Code: "COORDINATION_REQUIRES_TWO_EXACT_ATOMS", Message: "both direct positive clauses must have exact approved target bindings", Term: cloneAlgebraTerm(input.Expression)})
+		return &result, nil
+	}
+	for i := range matches {
+		if matches[i].atom == nil || matches[i].atom.Kind != algebra.TermAtom || matches[i].answerVariableID != "" {
+			return &result, nil
+		}
+	}
+	if matches[0].arguments[matches[0].eventPort].ID == matches[1].arguments[matches[1].eventPort].ID {
+		result.Residuals = append(result.Residuals, AlgebraRealizationResidual{Path: "input.expression", Code: "REPEATED_EVENT_IDENTITY", Message: "coordinated clauses require distinct Event references", Term: cloneAlgebraTerm(input.Expression)})
+		result.Status = status.OutcomeAmbiguous
+		return &result, nil
+	}
+	parts := make([]*semantic.MeaningCandidate, 2)
+	cov := make([]AlgebraRealizationCoverage, 2)
+	for i, match := range matches {
+		candidate, coverage, ctxResiduals, failure, code, path, message := buildAlgebraMeaningCandidate(engine, input, languageID, pkg, match)
+		if candidate == nil {
+			result.Residuals = append(result.Residuals, ctxResiduals...)
+			result.Residuals = append(result.Residuals, AlgebraRealizationResidual{Path: path, Code: code, Message: message, Term: cloneAlgebraTerm(match.atom)})
+			result.Status = failure
+			return &result, nil
+		}
+		parts[i], cov[i] = candidate, coverage
+		for _, r := range ctxResiduals {
+			if r.Code == "UNCONSUMED_CONTEXT_REFERENT" && coveredByEither(matches, r.ReferenceID) {
+				continue
+			}
+			if !containsAlgebraResidual(result.Residuals, r) {
+				result.Residuals = append(result.Residuals, r)
+			}
+		}
+	}
+	if refuseContextResiduals && len(result.Residuals) > 0 {
+		result.Status = status.OutcomeUnsupported
+		return &result, nil
+	}
+	graph, requestContext, remapped, entityIDs, err := mergeTwoAlgebraCandidates(parts, cov, input.RequestContext.ID)
+	if err != nil {
+		result.Status = status.OutcomeInvalid
+		result.Residuals = append(result.Residuals, AlgebraRealizationResidual{Path: "meaning", Code: "COORDINATION_MEANING_BUILD_FAILED", Message: err.Error()})
+		return &result, nil
+	}
+	for i := range cov {
+		cov[i].EventMeaningNode = remapped[i]
+		for j := range cov[i].RoleSubstitutions {
+			if cov[i].RoleSubstitutions[j].Role == "event_identity" {
+				cov[i].RoleSubstitutions[j].MeaningNodeID = remapped[i]
+			} else {
+				cov[i].RoleSubstitutions[j].MeaningNodeID = entityIDs[cov[i].RoleSubstitutions[j].ReferenceID]
+			}
+		}
+	}
+	result.Coverage = append(result.Coverage, cov...)
+	if err := meaning.ValidateMeaning(graph, engine.core, meaning.DefaultBudget()); err != nil {
+		result.Status = status.OutcomeInvalid
+		return &result, nil
+	}
+	if err := meaning.ValidateReferences(graph, requestContext, meaning.DefaultBudget()); err != nil {
+		result.Status = status.OutcomeInvalid
+		return &result, nil
+	}
+	combinedID := algebraCandidateID(input, pkg.ID(), cov[0].SenseID+":"+cov[1].SenseID)
+	candidate := &semantic.MeaningCandidate{ID: combinedID, SemanticID: combinedID, Meaning: &graph,
+		Contexts: []semantic.MeaningContext{{Meaning: graph, Context: requestContext}}, Status: status.OutcomeOK,
+		Evidence: semantic.EvidenceTrace{AlternativeID: combinedID, Outcome: status.OutcomeOK, Records: []semantic.EvidenceRecord{}}}
+	target, ok := engine.TargetRealizerFor(languageID)
+	if !ok || target == nil {
+		result.Status = status.OutcomeUnsupported
+		result.Diagnostics = append(result.Diagnostics, status.Diagnostic{Code: "TARGET_RUNTIME_UNAVAILABLE", Path: "language", Message: "no verified target adapter is available for the requested language", Severity: status.SeverityError})
+		return &result, nil
+	}
+	budget := engineBudget(engine)
+	requestCtx, cancel := context.WithTimeout(ctx, budget.RequestTimeout)
+	defer cancel()
+	surface, realizeErr := target.Realize(requestCtx, *candidate)
+	if realizeErr != nil {
+		return nil, realizeErr
+	}
+	if !surface.Outcome.Valid() || len(surface.Diagnostics) > status.MaxDiagnostics || len(surface.Alternatives) > budget.MaxSurfaceAlternatives || len(surface.Alternatives) > MaxTranslationAlternatives {
+		result.Status = status.OutcomeInvalid
+		result.Diagnostics = append(result.Diagnostics, status.Diagnostic{Code: "INVALID_COORDINATED_TARGET_RESULT", Path: "target", Message: "target returned an invalid or oversized coordinated result", Severity: status.SeverityError})
+		return &result, nil
+	}
+	for _, diagnostic := range surface.Diagnostics {
+		if diagnostic.Validate() != nil {
+			result.Status = status.OutcomeInvalid
+			result.Diagnostics = appendDiagnostic(result.Diagnostics, status.Diagnostic{Code: "INVALID_TARGET_DIAGNOSTIC", Path: "target.diagnostics", Message: "target returned an invalid diagnostic", Severity: status.SeverityError})
+			return &result, nil
+		}
+	}
+	result.Alternatives = append(result.Alternatives, surface.Alternatives...)
+	result.Diagnostics = appendDiagnostics(result.Diagnostics, surface.Diagnostics)
+	result.Status = surface.Outcome
+	targetLanguage, registered := engine.languages.Language(languageID)
+	if !registered {
+		result.Status = status.OutcomeUnsupported
+		return &result, nil
+	}
+	textBytes := 0
+	complete := false
+	seen := map[string]bool{}
+	for i, a := range result.Alternatives {
+		if !a.Outcome.Valid() || !validID(a.ID) || seen[a.ID] || len(a.Diagnostics) > status.MaxDiagnostics || len(a.Assumptions) > MaxTranslationAssumptions || len(a.Losses) > MaxTranslationLosses {
+			result.Status = status.OutcomeInvalid
+			result.Alternatives[i].Text = ""
+			continue
+		}
+		seen[a.ID] = true
+		for _, d := range a.Diagnostics {
+			if d.Validate() != nil {
+				result.Status = status.OutcomeInvalid
+			}
+		}
+		for _, v := range a.Assumptions {
+			if validateAssumption(v) != nil {
+				result.Status = status.OutcomeInvalid
+			}
+		}
+		for _, v := range a.Losses {
+			if validateLoss(v) != nil || a.Outcome == status.OutcomeOK && v.Outcome != status.OutcomeOK {
+				result.Status = status.OutcomeInvalid
+			}
+		}
+		if validateText(a.Text, MaxTranslationTextBytes, true) != nil {
+			result.Status = status.OutcomeResourceLimit
+			result.Alternatives[i].Text = ""
+			continue
+		}
+		if a.Text != "" {
+			textBytes += len(a.Text)
+			if textBytes > budget.MaxCandidateTextBytes {
+				result.Status = status.OutcomeResourceLimit
+				result.Alternatives[i].Text = ""
+				continue
+			}
+		}
+		if err := a.Evidence.Validate(); err != nil || a.Evidence.AlternativeID != a.ID || a.Evidence.Outcome != a.Outcome {
+			result.Status = status.OutcomeInvalid
+			result.Alternatives[i].Text = ""
+			continue
+		}
+		used := map[int]bool{}
+		proofOK := true
+		for _, c := range cov {
+			sense, se := ids.ParseSenseID(c.SenseID)
+			coreRef, ce := ids.ParseConceptID(c.CoreRef)
+			if se != nil || ce != nil || !hasCoordinatedGeneratedBindingEvidence(targetLanguage, a.Evidence, sense, coreRef, used) {
+				proofOK = false
+				break
+			}
+		}
+		if !proofOK {
+			result.Status = status.OutcomeUnsupported
+			result.Alternatives[i].Text = ""
+			continue
+		}
+		if a.Text != "" && (a.Outcome == status.OutcomeOK || a.Outcome == status.OutcomeIncomplete) {
+		}
+		if a.Outcome == status.OutcomeOK && a.Text != "" {
+			complete = true
+		}
+		if a.Text == "" && a.Outcome == status.OutcomeOK {
+			result.Status = status.OutcomeIncomplete
+		}
+		if a.Outcome != status.OutcomeOK && len(a.Diagnostics) == 0 {
+			result.Status = status.OutcomeInvalid
+		}
+	}
+	if complete && (result.Status == status.OutcomeUnknown || result.Status == status.OutcomeUnsupported) {
+		result.Status = status.OutcomeIncomplete
+		result.Diagnostics = appendDiagnostic(result.Diagnostics, status.Diagnostic{Code: "PARTIAL_TARGET_REALIZATION", Path: "target.alternatives", Message: "a complete coordinated alternative coexists with an unsupported aggregate target outcome", Severity: status.SeverityWarning})
+	}
+	if len(result.Alternatives) == 0 && result.Status == status.OutcomeOK {
+		failed := algebraRealizationFailure(result, status.OutcomeIncomplete, "NO_SURFACE_ALTERNATIVE", "target.alternatives", "target returned OK without a surface alternative")
+		return &failed, nil
+	}
+	if len(result.Residuals) > 0 && len(result.Alternatives) > 0 && result.Status == status.OutcomeOK {
+		result.Status = status.OutcomeIncomplete
+	}
+	return &result, nil
+}
+
+func hasCoordinatedGeneratedBindingEvidence(pack language.Language, trace semantic.EvidenceTrace, sense ids.SenseID, coreRef ids.ConceptID, used map[int]bool) bool {
+	for index, record := range trace.Records {
+		if used[index] || record.Origin != semantic.EvidenceOriginGenerated || record.Outcome != status.OutcomeOK || record.SenseID != sense || record.CoreConceptID != coreRef || record.BindingKey != semantic.BindingKeyFor(sense, coreRef) {
+			continue
+		}
+		for _, binding := range pack.Bindings {
+			if binding.SenseID != sense || binding.CoreRef != coreRef || !binding.Approved || !binding.Realize || binding.Mapping != lexicon.MappingEquivalent || binding.ValencyFrameID != string(record.FrameID) || binding.FamilyID != record.FamilyID {
+				continue
+			}
+			for _, variant := range binding.VariantIDs {
+				if variant.String() == record.VariantID.String() && record.PlanID != "" {
+					used[index] = true
+					return true
+				}
+			}
+		}
+	}
+	return false
+}
+
+func coveredByEither(matches []algebraAtomMatch, ref string) bool {
+	for _, m := range matches {
+		for _, a := range m.arguments {
+			if a != nil && a.Kind == algebra.TermRef && a.ID == ref {
+				return true
+			}
+		}
+	}
+	return false
+}
+func containsAlgebraResidual(values []AlgebraRealizationResidual, value AlgebraRealizationResidual) bool {
+	for _, v := range values {
+		if v.Code == value.Code && v.ReferenceID == value.ReferenceID && v.Path == value.Path {
+			return true
+		}
+	}
+	return false
+}
+
+func mergeTwoAlgebraCandidates(parts []*semantic.MeaningCandidate, coverage []AlgebraRealizationCoverage, originalContextID string) (meaning.Meaning, meaning.RequestContext, [2]meaning.NodeID, map[string]meaning.NodeID, error) {
+	var events [2]meaning.NodeID
+	entityIDs := map[string]meaning.NodeID{}
+	referentIDs := map[string]meaning.ReferentID{}
+	keysSet := map[string]bool{}
+	for _, c := range coverage {
+		for _, s := range c.RoleSubstitutions {
+			if s.Role != "event_identity" {
+				keysSet[s.ReferenceID] = true
+			}
+		}
+	}
+	keys := make([]string, 0, len(keysSet))
+	for k := range keysSet {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	for i, k := range keys {
+		entityIDs[k] = meaning.NodeID(fmt.Sprintf("dse_ref_%d", i))
+		referentIDs[k] = meaning.ReferentID(fmt.Sprintf("ref_%d", i))
+	}
+	concepts := map[string]meaning.ConceptRef{}
+	nodes := []meaning.Node{}
+	seen := map[meaning.NodeID]bool{}
+	for i, p := range parts {
+		if p == nil || p.Meaning == nil || len(p.Contexts) != 1 {
+			return meaning.Meaning{}, meaning.RequestContext{}, events, entityIDs, fmt.Errorf("clause candidate lacks one context")
+		}
+		events[i] = meaning.NodeID(fmt.Sprintf("dse_event_%d", i))
+		local := map[meaning.NodeID]meaning.NodeID{}
+		for _, n := range p.Meaning.Nodes {
+			n.Participants = append([]meaning.Participant(nil), n.Participants...)
+			if n.Kind == meaning.KindReferent {
+				ref := ""
+				for _, s := range coverage[i].RoleSubstitutions {
+					if s.MeaningNodeID == n.ID && s.Role != "event_identity" {
+						ref = s.ReferenceID
+						break
+					}
+				}
+				if ref == "" || entityIDs[ref] == "" {
+					return meaning.Meaning{}, meaning.RequestContext{}, events, entityIDs, fmt.Errorf("referent lacks bounded source identity mapping")
+				}
+				local[n.ID] = entityIDs[ref]
+			}
+		}
+		for _, n := range p.Meaning.Nodes {
+			if n.Kind == meaning.KindDiscourse {
+				continue
+			}
+			if n.Kind == meaning.KindEvent {
+				n.ID = events[i]
+				for j := range n.Participants {
+					if id, ok := local[n.Participants[j].Target]; ok {
+						n.Participants[j].Target = id
+					}
+				}
+			}
+			if n.Kind == meaning.KindReferent {
+				old := n.ID
+				ref := ""
+				for _, s := range coverage[i].RoleSubstitutions {
+					if s.MeaningNodeID == old && s.Role != "event_identity" {
+						ref = s.ReferenceID
+						break
+					}
+				}
+				n.ID = local[old]
+				if prior, ok := concepts[ref]; ok && prior != n.Concept {
+					return meaning.Meaning{}, meaning.RequestContext{}, events, entityIDs, fmt.Errorf("shared reference has conflicting concepts")
+				}
+				concepts[ref] = n.Concept
+			}
+			if !seen[n.ID] {
+				seen[n.ID] = true
+				nodes = append(nodes, n)
+			}
+		}
+	}
+	d, err := meaning.NewDiscourse("dse_discourse_0", meaning.ActStatement, []meaning.NodeID{events[0], events[1]})
+	if err != nil {
+		return meaning.Meaning{}, meaning.RequestContext{}, events, entityIDs, err
+	}
+	nodes = append(nodes, d)
+	graph, err := meaning.Build([]meaning.NodeID{d.ID}, nodes, meaning.DefaultBudget())
+	if err != nil {
+		return meaning.Meaning{}, meaning.RequestContext{}, events, entityIDs, err
+	}
+	ctx := meaning.RequestContext{ID: realizationContextID(originalContextID), Referents: []meaning.Referent{}, Mentions: []meaning.Mention{}}
+	for i, k := range keys {
+		concept := concepts[k]
+		ctx.Referents = append(ctx.Referents, meaning.Referent{ID: referentIDs[k], Concept: concept})
+		ctx.Mentions = append(ctx.Mentions, meaning.Mention{ID: meaning.MentionID(fmt.Sprintf("ir_ref_%d", i)), NodeID: entityIDs[k], ReferentID: referentIDs[k], EvidenceID: algebraReferenceEvidenceID(k)})
+	}
+	return graph, ctx, events, entityIDs, nil
+}
diff --git a/internal/runtime/target_coordination.go b/internal/runtime/target_coordination.go
new file mode 100644
index 0000000..18a782b
--- /dev/null
+++ b/internal/runtime/target_coordination.go
@@ -0,0 +1,225 @@
+package runtime
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"unicode"
+
+	"github.com/clickbytes/golingua/internal/construction"
+	"github.com/clickbytes/golingua/internal/engine"
+	"github.com/clickbytes/golingua/internal/meaning"
+	"github.com/clickbytes/golingua/internal/realizer"
+	"github.com/clickbytes/golingua/internal/semantic"
+	"github.com/clickbytes/golingua/internal/status"
+)
+
+func (pipeline *TargetPipeline) realizeCoordinated(ctx context.Context, source semantic.MeaningCandidate) (engine.SurfaceResult, bool, error) {
+	if source.Meaning == nil || pipeline.ClauseCoordination == nil {
+		return engine.SurfaceResult{}, false, nil
+	}
+	if source.QuestionAnswer != nil {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeUnsupported, "COORDINATION_QUERY_DATA_UNSUPPORTED", "source.question_answer", "coordinated statement target does not accept query answer data")
+	}
+	discourse, events, ok := coordinationEvents(*source.Meaning)
+	if !ok {
+		return engine.SurfaceResult{}, false, nil
+	}
+	_ = discourse
+	if err := meaning.ValidateMeaning(*source.Meaning, pipeline.Core, meaning.DefaultBudget()); err != nil {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeInvalid, "INVALID_COORDINATION_MEANING", "meaning", err.Error())
+	}
+	if len(source.Contexts) != 1 {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeInvalid, "COORDINATION_CONTEXT_COUNT", "source.contexts", "exactly one matching request context is required")
+	}
+	equal, eqErr := meaning.CanonicalEqual(source.Contexts[0].Meaning, *source.Meaning, meaning.DefaultBudget())
+	if eqErr != nil || !equal {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeInvalid, "COORDINATION_CONTEXT_MISMATCH", "source.contexts", "request context meaning must exactly match the target meaning")
+	}
+	allowed := map[meaning.NodeID]bool{discourse.ID: true, events[0]: true, events[1]: true}
+	nodeMap := map[meaning.NodeID]meaning.Node{}
+	for _, node := range source.Meaning.Nodes {
+		nodeMap[node.ID] = node
+	}
+	for _, id := range events {
+		n := nodeMap[id]
+		for _, p := range n.Participants {
+			allowed[p.Target] = true
+		}
+	}
+	if len(allowed) != len(source.Meaning.Nodes) {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeUnsupported, "COORDINATION_EXTRA_MEANING", "meaning", "coordinated statement contains unsupported extra nodes")
+	}
+	for _, n := range source.Meaning.Nodes {
+		if !allowed[n.ID] || n.Kind != meaning.KindDiscourse && n.Kind != meaning.KindEvent && n.Kind != meaning.KindReferent {
+			return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeUnsupported, "COORDINATION_EXTRA_MEANING", "meaning", "coordinated statement contains unsupported nodes or operators")
+		}
+	}
+	if pipeline.ClauseCoordination.Language != pipeline.Language || pipeline.ClauseCoordination.ID == "" {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeUnsupported, "COORDINATION_PLAN_UNAVAILABLE", "target.coordination", "language-local coordination plan is invalid")
+	}
+	if events[0] == events[1] {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeAmbiguous, "REPEATED_EVENT_IDENTITY", "meaning.discourse.content", "coordinated clauses must have distinct events")
+	}
+	views := make([]semantic.MeaningCandidate, 2)
+	for i, eventID := range events {
+		graph, ctxMeaning, err := coordinationClauseView(*source.Meaning, source.Contexts, eventID)
+		if err != nil {
+			return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeInvalid, "INVALID_COORDINATION_MEANING", "meaning", "coordinated clause projection failed validation")
+		}
+		views[i] = source
+		views[i].Meaning = &graph
+		views[i].Contexts = []semantic.MeaningContext{{Meaning: graph, Context: ctxMeaning}}
+		views[i].QuestionAnswer = nil
+		views[i].Evidence.Records = []semantic.EvidenceRecord{}
+	}
+	left, err := pipeline.Realize(ctx, views[0])
+	if err != nil {
+		return engine.SurfaceResult{}, true, err
+	}
+	right, err := pipeline.Realize(ctx, views[1])
+	if err != nil {
+		return engine.SurfaceResult{}, true, err
+	}
+	result := engine.SurfaceResult{Outcome: combineTargetOutcomes(left.Outcome, right.Outcome), Diagnostics: appendTargetDiagnostics(left.Diagnostics, right.Diagnostics...), Alternatives: []engine.SurfaceAlternative{}}
+	for _, a := range left.Alternatives {
+		if a.Text == "" || a.Outcome != status.OutcomeOK && a.Outcome != status.OutcomeIncomplete {
+			continue
+		}
+		for _, b := range right.Alternatives {
+			if b.Text == "" || b.Outcome != status.OutcomeOK && b.Outcome != status.OutcomeIncomplete {
+				continue
+			}
+			if err := ctx.Err(); err != nil {
+				return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeResourceLimit, "TARGET_REALIZATION_CANCELED", "context", "target realization was canceled or timed out")
+			}
+			if len(result.Alternatives) >= engine.MaxTranslationAlternatives {
+				return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeResourceLimit, "RESOURCE_LIMIT", "target.coordination.alternatives", "coordinated cross-product exceeds the alternative limit")
+			}
+			text := joinCoordinationClauses(a.Text, b.Text, *pipeline.ClauseCoordination)
+			if text == "" {
+				continue
+			}
+			outcome := combineTargetOutcomes(a.Outcome, b.Outcome)
+			id := coordinatedAlternativeID(pipeline.ClauseCoordination.ID, a.ID, b.ID)
+			records := append([]semantic.EvidenceRecord{}, a.Evidence.Records...)
+			records = append(records, b.Evidence.Records...)
+			trace := semantic.EvidenceTrace{AlternativeID: id, Outcome: outcome, Records: records}
+			if outcome != status.OutcomeOK {
+				trace.Diagnostics = appendTargetDiagnostics(a.Evidence.Diagnostics, b.Evidence.Diagnostics...)
+			}
+			result.Alternatives = append(result.Alternatives, engine.SurfaceAlternative{ID: id, Outcome: outcome, Text: text, Evidence: trace, Assumptions: append(append([]realizer.FieldAssumption{}, a.Assumptions...), b.Assumptions...), Losses: append(append([]realizer.FieldLoss{}, a.Losses...), b.Losses...), Diagnostics: appendTargetDiagnostics(a.Diagnostics, b.Diagnostics...)})
+		}
+	}
+	if len(result.Alternatives) == 0 {
+		return engine.SurfaceResult{}, true, targetPipelineError(status.OutcomeUnsupported, "COORDINATED_CLAUSE_INCOMPLETE", "target.coordination", "both clauses must have text-bearing complete alternatives")
+	}
+	return result, true, nil
+}
+
+func coordinationEvents(graph meaning.Meaning) (meaning.Node, [2]meaning.NodeID, bool) {
+	nodes := map[meaning.NodeID]meaning.Node{}
+	for _, n := range graph.Nodes {
+		nodes[n.ID] = n
+	}
+	if len(graph.Roots) != 1 {
+		return meaning.Node{}, [2]meaning.NodeID{}, false
+	}
+	d, ok := nodes[graph.Roots[0]]
+	if !ok || d.Kind != meaning.KindDiscourse || d.Act != meaning.ActStatement || len(d.Content) != 2 {
+		return meaning.Node{}, [2]meaning.NodeID{}, false
+	}
+	var ids [2]meaning.NodeID
+	for i, id := range d.Content {
+		n, exists := nodes[id]
+		if !exists || n.Kind != meaning.KindEvent {
+			return meaning.Node{}, ids, false
+		}
+		ids[i] = id
+	}
+	return d, ids, true
+}
+
+func coordinationClauseView(graph meaning.Meaning, contexts []semantic.MeaningContext, eventID meaning.NodeID) (meaning.Meaning, meaning.RequestContext, error) {
+	nodes := map[meaning.NodeID]meaning.Node{}
+	for _, n := range graph.Nodes {
+		nodes[n.ID] = n
+	}
+	event, ok := nodes[eventID]
+	if !ok {
+		return meaning.Meaning{}, meaning.RequestContext{}, fmt.Errorf("event node is missing")
+	}
+	keep := map[meaning.NodeID]bool{eventID: true}
+	for _, p := range event.Participants {
+		keep[p.Target] = true
+	}
+	out := []meaning.Node{}
+	for _, n := range graph.Nodes {
+		if n.Kind == meaning.KindDiscourse {
+			n.Content = []meaning.NodeID{eventID}
+			keep[n.ID] = true
+		}
+		if keep[n.ID] || n.Kind == meaning.KindDiscourse {
+			out = append(out, n)
+		}
+	}
+	view, err := meaning.Build([]meaning.NodeID{graph.Roots[0]}, out, meaning.DefaultBudget())
+	if err != nil {
+		return meaning.Meaning{}, meaning.RequestContext{}, err
+	}
+	var sourceCtx meaning.RequestContext
+	for _, c := range contexts {
+		equal, eqErr := meaning.CanonicalEqual(c.Meaning, graph, meaning.DefaultBudget())
+		if eqErr == nil && equal {
+			sourceCtx = c.Context
+			break
+		}
+	}
+	if sourceCtx.ID == "" {
+		return meaning.Meaning{}, meaning.RequestContext{}, fmt.Errorf("validated request context does not exactly match coordinated meaning")
+	}
+	filtered := meaning.RequestContext{ID: sourceCtx.ID, Referents: []meaning.Referent{}, Mentions: []meaning.Mention{}}
+	refIDs := map[meaning.ReferentID]bool{}
+	for _, m := range sourceCtx.Mentions {
+		if keep[m.NodeID] {
+			filtered.Mentions = append(filtered.Mentions, m)
+			if m.ReferentID != "" {
+				refIDs[m.ReferentID] = true
+			}
+		}
+	}
+	for _, r := range sourceCtx.Referents {
+		if refIDs[r.ID] {
+			filtered.Referents = append(filtered.Referents, r)
+		}
+	}
+	if err := meaning.ValidateReferences(view, filtered, meaning.DefaultBudget()); err != nil {
+		return meaning.Meaning{}, meaning.RequestContext{}, err
+	}
+	return view, filtered, nil
+}
+
+func joinCoordinationClauses(a, b string, plan construction.ClauseCoordinationPlan) string {
+	a = strings.TrimSpace(a)
+	b = strings.TrimSpace(b)
+	if !strings.HasSuffix(a, ".") || !strings.HasSuffix(b, ".") {
+		return ""
+	}
+	a = strings.TrimSuffix(a, ".")
+	b = strings.TrimSuffix(b, ".")
+	if plan.LowerSecond {
+		runes := []rune(b)
+		if len(runes) > 0 {
+			runes[0] = unicode.ToLower(runes[0])
+			b = string(runes)
+		}
+	}
+	return a + " " + plan.Connector + " " + b + plan.FinalPeriod
+}
+
+func coordinatedAlternativeID(plan, left, right string) string {
+	sum := sha256.Sum256([]byte(plan + "\x00" + left + "\x00" + right))
+	return "coord:" + hex.EncodeToString(sum[:])
+}
